[Desktop Entry]
Type=Application
Name=Omnimark
GenericName=Markdown Viewer
Comment=View and edit Markdown with diagrams, math and syntax highlighting
Exec=omnimark %F
Icon=io.github.omnimark.Omnimark
Terminal=false
Categories=Office;Viewer;Utility;TextEditor;Qt;
MimeType=text/markdown;text/x-markdown;
Keywords=markdown;md;viewer;editor;mermaid;preview;
StartupNotify=true
StartupWMClass=omnimark
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=omnimark --new-instance
