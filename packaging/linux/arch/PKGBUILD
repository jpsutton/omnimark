# Builds Omnimark from this source checkout:
#   cd packaging/linux/arch && makepkg -si
pkgname=omnimark
pkgver=0.1.0
pkgrel=1
pkgdesc="Markdown viewer and editor with diagrams, math and syntax highlighting"
arch=(x86_64 aarch64)
url="https://github.com/jpsutton/omnimark"
license=(MIT)
depends=(qt6-base qt6-webengine qt6-webchannel hicolor-icon-theme)
makedepends=(cmake ninja nodejs pnpm)
options=(!debug)

_srcroot="$(realpath "${startdir}/../../..")"

build() {
  cmake -S "${_srcroot}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DOMNIMARK_BUILD_TESTS=OFF
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 "${_srcroot}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
