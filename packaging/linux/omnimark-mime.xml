<?xml version="1.0" encoding="UTF-8"?>
<!-- Most systems already define text/markdown; this adds the less common extensions. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/markdown">
    <glob pattern="*.md"/>
    <glob pattern="*.markdown"/>
    <glob pattern="*.mdown"/>
    <glob pattern="*.mkd"/>
    <glob pattern="*.mdx"/>
  </mime-type>
</mime-info>
